[access]
	inheritFrom = All-Projects
[submit]
[project]
	description = Redis is an in-memory database that persists on disk. The data model is key-value, but many different kind of values are supported: Strings, Lists, Sets, Sorted Sets, Hashes, Streams, HyperLogLogs, Bitmaps.
[access "refs/*"]
	owner = group user/kasiawasiuta
[access "refs/for/refs/*"]
	label-Code-Review = -2..+2 group user/kasiawasiuta
	label-Verified = -1..+1 group user/kasiawasiuta
	push = group user/kasiawasiuta
	read = group user/kasiawasiuta
	rebase = group user/kasiawasiuta
	removeReviewer = group user/kasiawasiuta
	submit = group user/kasiawasiuta
[access "refs/heads/*"]
	create = group user/kasiawasiuta
	push = +force group user/kasiawasiuta
	pushMerge = group user/kasiawasiuta
	read = group user/kasiawasiuta
[access "refs/tags/*"]
	push = group user/kasiawasiuta
	push = +force group user/kasiawasiuta
